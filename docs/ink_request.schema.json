{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kana-memory:ink-request:v1",
  "title": "InkRecognizer request — design contract, not an implementation",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "model_language", "writing_area", "strokes"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "model_language": {"const": "ja"},
    "writing_area": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "height", "coordinate_unit"],
      "properties": {
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0},
        "coordinate_unit": {"const": "view_local"}
      }
    },
    "strokes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "array", "minItems": 1,
        "items": {
          "type": "object", "additionalProperties": false,
          "required": ["x", "y", "t_ms"],
          "properties": {
            "x": {"type": "number"}, "y": {"type": "number"},
            "t_ms": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  },
  "$comment": "All points use the same coordinate frame. Time must be monotonic across ordered strokes; validate this in the adapter. The request deliberately has no expected answer or answer-derived preContext. Raw strokes are ephemeral by default."
}
